{
  "name": "private-tutor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run build",
    "doctor": "tsx scripts/doctor.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "https-proxy-agent": "7.0.6",
    "openai": "7.9.0",
    "proxy-from-env": "1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/proxy-from-env": "1.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
