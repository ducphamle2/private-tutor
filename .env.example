# Server only. Never prefix this variable with VITE_.
OPENAI_API_KEY=

# Responses model that runs the tutor agent (file tools + web search).
OPENAI_BACKEND_MODEL=gpt-5.4-mini

# Folder with your .md/.txt study notes. The agent can only read and write inside it.
STUDY_DIR=/Users/you/notes

# Sessions end automatically. Valid range: 60–3600 seconds.
MAX_SESSION_SECONDS=1800

# This app always binds 127.0.0.1.
PORT=3000

# Optional limits
# MAX_DELEGATIONS=100
# MAX_TOOL_CALLS=300
# MAX_TOOL_ROUNDS=6
# BACKEND_MAX_OUTPUT_TOKENS=2000
# BACKEND_RESULT_MAX_CHARS=4000
# TOPIC_MAX_CHARS=20000
# READ_MAX_CHARS=20000

# Conversation history (default: <repo>/conversations)
# CONVERSATIONS_DIR=
# SNAPSHOT_MAX_OUTPUT_TOKENS=2000
